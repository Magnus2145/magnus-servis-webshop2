{
  "extends": "@magnus/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "outDir": "dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noEmit": false,
    "types": ["node", "jest"]
  },
  "include": ["src", "scripts", "types"],
  "exclude": ["node_modules", "dist"]
}
