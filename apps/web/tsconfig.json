{
  "extends": "@magnus/config/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@/src/*": ["./src/*"],
      "@magnus/ui": ["../../packages/ui/src"],
      "@magnus/ui/*": ["../../packages/ui/src/*"]
    },
    "types": ["jest", "node"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.mjs"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
